# ============================================================
# HelixDriving — environment variables
# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.
# ============================================================

# ── Supabase (required — app will not boot without these) ──────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key: SERVER ONLY. Never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── App URL (required) ─────────────────────────────────────────
# Absolute base URL, no trailing slash. Used to build links in emails
# (password reset, instructor invites). If missing, those links are broken.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Cron (required) ────────────────────────────────────────────
# Shared secret checked by /api/cron/regenerate-openings. Vercel Cron must send
# it as `Authorization: Bearer <CRON_SECRET>`. If missing, the daily openings
# job fails closed and schedules are never regenerated. Use a long random string.
CRON_SECRET=generate-a-long-random-string

# ── Email via Resend (required to send any email) ──────────────
# Without these, emails are silently skipped (only a console.warn).
RESEND_API_KEY=re_your_resend_api_key
# Verified sender in Resend, e.g. "HelixDriving <no-reply@your-domain.com>"
EMAIL_FROM=HelixDriving <no-reply@your-domain.com>

# ── Timezone ───────────────────────────────────────────────────
# Process timezone used by server-side date math. Defaults to America/Chicago
# if unset. Set to the timezone your schools operate in.
# NOTE: this is a single global value; per-school timezone (schools.timezone)
# is a separate, pending fix.
APP_TZ=America/Chicago
